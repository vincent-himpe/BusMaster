<Window x:Class="TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BusMaster"
        mc:Ignorable="d"
        Title="Terminal"
        Height="520" Width="760" MinHeight="260" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Brush_Window_Background}"
        Foreground="{StaticResource Brush_Text_Primary}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <DockPanel LastChildFill="True">

        <!-- ==================================================================
             Tool bar
             ================================================================== -->
        <Border x:Name="tlbr_Terminal" DockPanel.Dock="Top"
                Background="{StaticResource Brush_Chrome_Background}"
                BorderBrush="{StaticResource Brush_Chrome_Border}"
                BorderThickness="0,0,0,1"
                Padding="4,3">
            <DockPanel LastChildFill="False">

                <!-- A fresh page, not a cross: a cross next to the probe reads as
                     "disconnect", which is not what this does. -->
                <Button x:Name="tlbr_Terminal_Clear"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Content="&#xE729;"
                        ToolTip="Empty the transcript"
                        Click="tlbr_Terminal_Clear_Click"/>

                <Separator x:Name="tlbr_Terminal_Divider"
                           DockPanel.Dock="Left"
                           Style="{StaticResource Style_Toolbar_Separator}"/>

                <TextBlock x:Name="lbl_BufferSize"
                           DockPanel.Dock="Left"
                           Margin="4,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush_Text_Primary}"
                           Text="BufferSize"/>

                <!-- How many lines the transcript keeps. Typed or spun; either way
                     it is held between 5 and 200. -->
                <TextBox x:Name="txt_BufferSize"
                         DockPanel.Dock="Left"
                         Width="46"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         TextAlignment="Right"
                         MaxLength="3"
                         Text="20"
                         PreviewTextInput="txt_BufferSize_PreviewTextInput"
                         PreviewKeyDown="txt_BufferSize_PreviewKeyDown"
                         LostKeyboardFocus="txt_BufferSize_LostKeyboardFocus"/>

                <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <RepeatButton x:Name="tlbr_Buffer_Up"
                                  Grid.Row="0"
                                  Style="{StaticResource Style_Spinner_Up}"
                                  ToolTip="Keep more lines"
                                  Click="tlbr_Buffer_Up_Click"/>

                    <RepeatButton x:Name="tlbr_Buffer_Down"
                                  Grid.Row="1"
                                  Style="{StaticResource Style_Spinner_Down}"
                                  ToolTip="Keep fewer lines"
                                  Click="tlbr_Buffer_Down_Click"/>
                </Grid>

                <!-- Which probe this transcript is talking to. Declared before its
                     caption so that, docked right, it lands after it. -->
                <TextBlock x:Name="lbl_ProbePort"
                           DockPanel.Dock="Right"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="13"
                           Text="No Probe"/>

                <TextBlock x:Name="lbl_Probe"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush_Text_Primary}"
                           Text="Probe : "/>

            </DockPanel>
        </Border>

        <!-- ==================================================================
             What the user is about to send
             ================================================================== -->
        <TextBox x:Name="txt_TerminalEntry"
                 DockPanel.Dock="Bottom"
                 Margin="6,0,6,6"
                 FontFamily="Consolas"
                 FontSize="13"
                 Padding="4,4"
                 AcceptsReturn="False"
                 AcceptsTab="False"
                 PreviewKeyDown="txt_TerminalEntry_PreviewKeyDown"
                 PreviewTextInput="txt_TerminalEntry_PreviewTextInput"/>

        <!-- ==================================================================
             The transcript. Read-only: the user reads it and double-clicks a
             line to put it back on the entry line, but only the probe and the
             user's own sends write here.
             ================================================================== -->
        <RichTextBox x:Name="rtb_TerminalHistory"
                     Margin="6,6,6,4"
                     Style="{StaticResource Style_Terminal_History}"
                     MouseDoubleClick="rtb_TerminalHistory_MouseDoubleClick">
            <RichTextBox.Resources>
                <Style TargetType="{x:Type Paragraph}">
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>

    </DockPanel>
</Window>
