<Window x:Class="ProvisionProbeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BusMaster"
        mc:Ignorable="d"
        Title="Provision Probe"
        SizeToContent="Height"
        Width="470"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush_Window_Background}"
        Foreground="{StaticResource Brush_Text_Primary}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- What the user has to do to the hardware before any of the buttons
             below can work. A TextBlock rather than a Label: a Label runs its
             string through AccessText, which eats underscores. -->
        <TextBlock x:Name="lbl_Instructions"
                   Grid.Row="0"
                   Margin="0,0,0,14"
                   TextWrapping="Wrap"
                   LineHeight="18"
                   Foreground="{StaticResource Brush_Text_Primary}"
                   Text="Provision a blank STM32 processor with the firmware. Hold down the BOOT button, then trigger the RESET button. You can then release the BOOT button."/>

        <Button x:Name="btn_SelectFirmware"
                Grid.Row="1"
                HorizontalAlignment="Left"
                MinWidth="120"
                Content="Select _Firmware"
                ToolTip="Pick the .BIN file to flash"
                Click="btn_SelectFirmware_Click"/>

        <!-- The file the button above picked. Fixed pitch, because a path is read
             character by character when something is wrong with it. -->
        <TextBlock x:Name="lbl_FirmwarePath"
                   Grid.Row="2"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   FontFamily="Consolas"
                   FontSize="11"
                   Foreground="{StaticResource Brush_Text_Secondary}"
                   Text="No firmware selected"/>

        <!-- Where the scan and the flash report what happened. Empty until one of
             them has something to say. -->
        <TextBlock x:Name="lbl_Status"
                   Grid.Row="3"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Brush_Text_Secondary}"
                   Text=""/>

        <!-- Scan then Flash, in the order they are done, and Close away to the
             right where a way out belongs. -->
        <Grid Grid.Row="4" Margin="0,18,0,0">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                <Button x:Name="btn_ScanDevices"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Content="Scan _Devices"
                        ToolTip="Look for an STM32 waiting in DFU mode"
                        Click="btn_ScanDevices_Click"/>

                <Button x:Name="btn_FlashFirmware"
                        MinWidth="110"
                        IsEnabled="False"
                        Content="Flash Firm_ware"
                        ToolTip="Write the selected firmware to the processor"
                        Click="btn_FlashFirmware_Click"/>

            </StackPanel>

            <!-- Not IsCancel - see MessagePromptWindow for what that property does
                 behind a Click handler's back. Escape is taken in the module. -->
            <Button x:Name="btn_Close"
                    HorizontalAlignment="Right"
                    MinWidth="90"
                    Content="_Close"
                    Click="btn_Close_Click"/>

        </Grid>
    </Grid>
</Window>
