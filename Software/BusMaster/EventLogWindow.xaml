<Window x:Class="EventLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BusMaster"
        mc:Ignorable="d"
        Title="Event Log"
        Height="520" Width="760" MinHeight="260" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Brush_Window_Background}"
        Foreground="{StaticResource Brush_Text_Primary}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <DockPanel LastChildFill="True">

        <!-- ==================================================================
             Tool bar
             ================================================================== -->
        <Border x:Name="tlbr_Log" DockPanel.Dock="Top"
                Background="{StaticResource Brush_Chrome_Background}"
                BorderBrush="{StaticResource Brush_Chrome_Border}"
                BorderThickness="0,0,0,1"
                Padding="4,3">
            <DockPanel LastChildFill="False">

                <Button x:Name="tlbr_Log_Save_As"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Text_Button}"
                        Width="66"
                        FontFamily="Segoe UI"
                        FontWeight="SemiBold"
                        Content="Save As"
                        ToolTip="Save the log under a new name"
                        Click="tlbr_Log_Save_As_Click"/>

                <Button x:Name="tlbr_Log_Save"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Content="&#xE74E;"
                        ToolTip="Save the log"
                        Click="tlbr_Log_Save_Click"/>

                <Separator x:Name="tlbr_Log_Separator_1"
                           DockPanel.Dock="Left"
                           Style="{StaticResource Style_Toolbar_Separator}"/>

                <!-- Replay one line: hollow red triangle. -->
                <Button x:Name="tlbr_Log_Replay"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Button}"
                        ToolTip="Replay the current line"
                        Click="tlbr_Log_Replay_Click">
                    <Path Data="M 0,0 L 9,5.5 L 0,11 Z"
                          Stroke="{StaticResource Brush_Log_Replay}"
                          StrokeThickness="1.4"
                          StrokeLineJoin="Miter"
                          Fill="Transparent"/>
                </Button>

                <!-- Replay a block: the same triangle, filled. -->
                <Button x:Name="tlbr_Log_Replay_Block"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Button}"
                        ToolTip="Replay the selected block"
                        Click="tlbr_Log_Replay_Block_Click">
                    <Path Data="M 0,0 L 9,5.5 L 0,11 Z"
                          Fill="{StaticResource Brush_Log_Replay}"/>
                </Button>

                <!-- Replay everything: double triangle. -->
                <Button x:Name="tlbr_Log_Replay_All"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Button}"
                        ToolTip="Replay the whole log"
                        Click="tlbr_Log_Replay_All_Click">
                    <Path Data="M 0,0 L 6,5.5 L 0,11 Z M 6,0 L 12,5.5 L 6,11 Z"
                          Fill="{StaticResource Brush_Log_Replay}"/>
                </Button>

                <Separator x:Name="tlbr_Log_Separator_2"
                           DockPanel.Dock="Left"
                           Style="{StaticResource Style_Toolbar_Separator}"/>

                <Button x:Name="tlbr_Log_Clear"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Content="&#xE894;"
                        ToolTip="Empty the log"
                        Click="tlbr_Log_Clear_Click"/>

            </DockPanel>
        </Border>

        <!-- ==================================================================
             The log itself. Never sortable: the order is the record.
             ================================================================== -->
        <DataGrid x:Name="grd_Log"
                  Margin="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  SelectionUnit="Cell"
                  SelectionMode="Extended"
                  GridLinesVisibility="None"
                  AlternationCount="2"
                  RowStyle="{StaticResource Style_Log_Row}"
                  VerticalScrollBarVisibility="Visible">
            <DataGrid.Columns>

                <DataGridTextColumn Header="#" Width="52"
                                    IsReadOnly="True"
                                    CanUserSort="False"
                                    Binding="{Binding Number}"
                                    CellStyle="{StaticResource Style_Log_Cell_Number}"
                                    ElementStyle="{StaticResource Style_Log_Display}"/>

                <DataGridTextColumn Header="" Width="34"
                                    CanUserSort="False"
                                    Binding="{Binding Marker, UpdateSourceTrigger=PropertyChanged}"
                                    CellStyle="{StaticResource Style_Log_Cell}"
                                    ElementStyle="{StaticResource Style_Log_Display}"
                                    EditingElementStyle="{StaticResource Style_Log_Edit}"/>

                <!-- Host, Reg and Value each hold a number from 0 to 255. Wide enough
                     for four characters of content; the width is set by the column
                     headings, which are wider than the numbers under them. -->
                <DataGridTextColumn Header="Host" Width="54"
                                    CanUserSort="False"
                                    Binding="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                    CellStyle="{StaticResource Style_Log_Cell}"
                                    ElementStyle="{StaticResource Style_Log_Display}"
                                    EditingElementStyle="{StaticResource Style_Log_Edit_Short}"/>

                <DataGridTextColumn Header="Reg" Width="54"
                                    CanUserSort="False"
                                    Binding="{Binding Reg, UpdateSourceTrigger=PropertyChanged}"
                                    CellStyle="{StaticResource Style_Log_Cell}"
                                    ElementStyle="{StaticResource Style_Log_Display}"
                                    EditingElementStyle="{StaticResource Style_Log_Edit_Short}"/>

                <DataGridTextColumn Header="Value" Width="54"
                                    CanUserSort="False"
                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                    CellStyle="{StaticResource Style_Log_Cell}"
                                    ElementStyle="{StaticResource Style_Log_Display}"
                                    EditingElementStyle="{StaticResource Style_Log_Edit_Short}"/>

                <DataGridTextColumn Header="Comment" Width="*"
                                    CanUserSort="False"
                                    Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                    CellStyle="{StaticResource Style_Log_Cell_Comment}"
                                    ElementStyle="{StaticResource Style_Log_Display}"
                                    EditingElementStyle="{StaticResource Style_Log_Edit}"/>

            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
