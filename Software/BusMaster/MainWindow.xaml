<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BusMaster"
        mc:Ignorable="d"
        Title="BusMaster"
        Height="650" Width="1000" MinHeight="600" MinWidth="600"
        Background="{StaticResource Brush_Window_Background}"
        Foreground="{StaticResource Brush_Text_Primary}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <!-- Keyboard shortcuts. These route to the same subroutines the menu and the
         toolbar call, so there is exactly one implementation of every command. -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New"    Executed="Cmd_New_Executed"/>
        <CommandBinding Command="ApplicationCommands.Open"   Executed="Cmd_Open_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save"   Executed="Cmd_Save_Executed"/>
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="Cmd_SaveAs_Executed"/>
        <CommandBinding Command="ApplicationCommands.Help"   Executed="Cmd_Help_Executed"/>
    </Window.CommandBindings>

    <Window.InputBindings>
        <!-- New / Open / Save / Help already carry their standard gestures. -->
        <KeyBinding Command="ApplicationCommands.SaveAs" Key="S" Modifiers="Ctrl+Shift"/>
    </Window.InputBindings>

    <DockPanel LastChildFill="True">

        <!-- ==================================================================
             Menu bar
             ================================================================== -->
        <Menu x:Name="mnu_Main" DockPanel.Dock="Top">
            <MenuItem x:Name="mnu_File" Header="_File">

                <MenuItem x:Name="mnu_File_New_Project"
                          Header="_New Project"
                          InputGestureText="Ctrl+N"
                          Click="mnu_File_New_Project_Click"/>

                <MenuItem x:Name="mnu_File_Open_Project"
                          Header="_Open Project..."
                          InputGestureText="Ctrl+O"
                          Click="mnu_File_Open_Project_Click"/>

                <MenuItem x:Name="mnu_File_Save_Project"
                          Header="_Save Project"
                          InputGestureText="Ctrl+S"
                          Click="mnu_File_Save_Project_Click"/>

                <MenuItem x:Name="mnu_File_Save_Project_As"
                          Header="Save Project _As..."
                          InputGestureText="Ctrl+Shift+S"
                          Click="mnu_File_Save_Project_As_Click"/>

                <Separator x:Name="mnu_File_Separator_1"/>

                <!-- Caption for the MRU block. Disabled on purpose: it is a label,
                     not a command. -->
                <MenuItem x:Name="mnu_File_Recently_Used"
                          Header="Recently Used"
                          IsEnabled="False"/>

                <MenuItem x:Name="mnu_File_Recent_1" Click="mnu_File_Recent_Click"/>
                <MenuItem x:Name="mnu_File_Recent_2" Click="mnu_File_Recent_Click"/>
                <MenuItem x:Name="mnu_File_Recent_3" Click="mnu_File_Recent_Click"/>
                <MenuItem x:Name="mnu_File_Recent_4" Click="mnu_File_Recent_Click"/>
                <MenuItem x:Name="mnu_File_Recent_5" Click="mnu_File_Recent_Click"/>

                <MenuItem x:Name="mnu_File_Recent_Empty"
                          Header="(no recent projects)"
                          IsEnabled="False"/>

                <Separator x:Name="mnu_File_Separator_2"/>

                <!-- "O" is already Open Project's, so Options takes P. -->
                <MenuItem x:Name="mnu_File_Options"
                          Header="O_ptions..."
                          Click="mnu_File_Options_Click"/>

                <Separator x:Name="mnu_File_Separator_3"/>

                <MenuItem x:Name="mnu_File_Exit"
                          Header="E_xit"
                          InputGestureText="Alt+F4"
                          Click="mnu_File_Exit_Click"/>

            </MenuItem>

            <MenuItem x:Name="mnu_View" Header="_View">

                <MenuItem x:Name="mnu_View_Decimal"
                          Header="_Decimal"
                          IsCheckable="True"
                          Click="mnu_View_Decimal_Click"/>

                <MenuItem x:Name="mnu_View_Hexadecimal"
                          Header="_Hexadecimal"
                          IsCheckable="True"
                          Click="mnu_View_Hexadecimal_Click"/>

            </MenuItem>

            <MenuItem x:Name="mnu_Device" Header="_Device">

                <!-- No Remove here: a device is deleted by right-clicking its own
                     header, which is unambiguous about which one goes. -->
                <MenuItem x:Name="mnu_Device_Add_Device"
                          Header="_Add Device..."
                          Click="mnu_Device_Add_Device_Click"/>

            </MenuItem>

            <MenuItem x:Name="mnu_Bus" Header="_Bus">

                <MenuItem x:Name="mnu_Bus_Scan_Bus"
                          Header="_Scan Bus"
                          Click="mnu_Bus_Scan_Bus_Click"/>

                <MenuItem x:Name="mnu_Bus_Poll_Bus"
                          Header="_Poll Bus"
                          Click="mnu_Bus_Poll_Bus_Click"/>

                <MenuItem x:Name="mnu_Bus_Reset_Bus"
                          Header="_Reset Bus"
                          Click="mnu_Bus_Reset_Bus_Click"/>

            </MenuItem>

            <MenuItem x:Name="mnu_Tools" Header="_Tools">

                <MenuItem x:Name="mnu_Tools_Create_Device"
                          Header="_Create Device..."
                          Click="mnu_Tools_Create_Device_Click"/>

                <MenuItem x:Name="mnu_Tools_Edit_Device"
                          Header="_Edit Device..."
                          Click="mnu_Tools_Edit_Device_Click"/>

                <MenuItem x:Name="mnu_Tools_Clone_Device"
                          Header="C_lone Device..."
                          Click="mnu_Tools_Clone_Device_Click"/>

                <Separator x:Name="mnu_Tools_Separator_1"/>

                <MenuItem x:Name="mnu_Tools_Show_Log"
                          Header="Show _Log"
                          Click="mnu_Tools_Show_Log_Click"/>

                <MenuItem x:Name="mnu_Tools_Show_Command"
                          Header="Show Co_mmand"
                          Click="mnu_Tools_Show_Command_Click"/>

                <MenuItem x:Name="mnu_Tools_Show_Terminal"
                          Header="Show _Terminal"
                          Click="mnu_Tools_Show_Terminal_Click"/>

                <Separator x:Name="mnu_Tools_Separator_2"/>

                <MenuItem x:Name="mnu_Tools_Show_Config_Files"
                          Header="Show Config Files"
                          Click="mnu_Tools_Show_Config_Files_Click"/>

                <MenuItem x:Name="mnu_Tools_Show_Dev_Files"
                          Header="Show Dev Files"
                          Click="mnu_Tools_Show_Dev_Files_Click"/>

                <MenuItem x:Name="mnu_Tools_Show_Project_Files"
                          Header="Show Project Files"
                          Click="mnu_Tools_Show_Project_Files_Click"/>

                <Separator x:Name="mnu_Tools_Separator_3"/>

                <!-- Firmware for the probe itself, not for anything on the bus.
                     Both entries talk to the STM32 over DFU - see
                     Modules\ProbeFirmware.vb. -->
                <MenuItem x:Name="mnu_Tools_Probe_Firmware" Header="_Probe Firmware">

                    <MenuItem x:Name="mnu_Tools_Probe_Firmware_Update"
                              Header="_Update Firmware..."
                              Click="mnu_Tools_Probe_Firmware_Update_Click"/>

                    <MenuItem x:Name="mnu_Tools_Probe_Firmware_Provision"
                              Header="_Provision Probe..."
                              Click="mnu_Tools_Probe_Firmware_Provision_Click"/>

                </MenuItem>

            </MenuItem>
        </Menu>

        <!-- ==================================================================
             Tool bar, first row - the hardware.

             Left: the probe link. Right: four user signals, then whether the
             target is held in reset, then a reset pulse. Everything on this row
             acts on the thing on the bench rather than on the project, and the
             signals sit at the right hand end so they stay put as controls are
             added on the left.

             The two groups to the right of the connect button are panels rather
             than loose right-docked children, so they read left to right here the
             way they do on screen, and so each can be greyed out in one move.
             ================================================================== -->
        <Border x:Name="tlbr_Hardware"
                DockPanel.Dock="Top"
                Background="{StaticResource Brush_Chrome_Background}"
                BorderBrush="{StaticResource Brush_Chrome_Border}"
                BorderThickness="0,0,0,1"
                Padding="4,3">
            <DockPanel LastChildFill="False">

                <TextBlock x:Name="tlbr_Probe_Label"
                           DockPanel.Dock="Left"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush_Text_Primary}"
                           Text="Probe"/>

                <Button x:Name="tlbr_Probe_Rescan"
                        DockPanel.Dock="Left"
                        Margin="4,0,0,0"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Foreground="{StaticResource Brush_Workspace_Action}"
                        Content="&#xE1CD;"
                        ToolTip="Look for a BusMaster probe on the USB bus"
                        Click="tlbr_Probe_Rescan_Click"/>

                <!-- Room to spell out a probe's name now that this row is its
                     own, and then some: a probe can be given a long name and the
                     list is no use if it reads "BusMaster Front..." -->
                <ComboBox x:Name="tlbr_Probe_List"
                          DockPanel.Dock="Left"
                          Width="300"
                          Margin="4,0"
                          VerticalAlignment="Center"
                          ToolTip="Serial port the probe is on"
                          SelectionChanged="tlbr_Probe_List_SelectionChanged"/>

                <ToggleButton x:Name="tlbr_Probe_Connect"
                              DockPanel.Dock="Left"
                              Style="{StaticResource Style_Toolbar_Connect_Toggle}"
                              Checked="tlbr_Probe_Connect_Checked"
                              Unchecked="tlbr_Probe_Connect_Unchecked"/>

                <Separator x:Name="tlbr_Bus_Divider"
                           DockPanel.Dock="Left"
                           Style="{StaticResource Style_Toolbar_Separator}"/>

                <!-- Everything the probe does to the bus itself. One label for the
                     three of them, so each button only has to say what it does.
                     Disabled as a block while there is no probe: see
                     AppCore.RefreshProbeConnection. -->
                <StackPanel x:Name="tlbr_Bus_Block"
                            DockPanel.Dock="Left"
                            Orientation="Horizontal">

                    <TextBlock x:Name="tlbr_Bus_Label"
                               Style="{StaticResource Style_Toolbar_Label}"
                               Margin="2,0,2,0"
                               Text="Bus:"/>

                    <Button x:Name="tlbr_Bus_Release"
                            Style="{StaticResource Style_Toolbar_Bus_Button}"
                            ToolTip="Let go of the bus - stop driving SCL and SDA"
                            Click="tlbr_Bus_Release_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Style_Toolbar_Bus_Glyph}" Text="&#xEC26;"/>
                            <TextBlock Style="{StaticResource Style_Toolbar_Bus_Text}" Text="Release"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="tlbr_Bus_Clear"
                            Style="{StaticResource Style_Toolbar_Bus_Button}"
                            ToolTip="Clock a stuck slave off the bus and leave it idle"
                            Click="tlbr_Bus_Clear_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Style_Toolbar_Bus_Glyph}" Text="&#xEA99;"/>
                            <TextBlock Style="{StaticResource Style_Toolbar_Bus_Text}" Text="Clear"/>
                        </StackPanel>
                    </Button>

                    <!-- How the probe drives the two lines. Released is 0/Z, which
                         is what I2C is: pull down, or let the pull-up have it.
                         Pressed is 0/1, driving both ways - useful on a bench, and
                         not something to be in by accident, so it is not where
                         this starts. -->
                    <ToggleButton x:Name="tlbr_Bus_Drive"
                                  Style="{StaticResource Style_Toolbar_Drive_Toggle}"
                                  Click="tlbr_Bus_Drive_Click"/>

                </StackPanel>

                <!-- The signals and the target's reset line. One panel rather
                     than a row of right-docked children, so these read left to
                     right in the file the way they do on screen - and so the whole
                     lot can be disabled in one go while there is no probe. -->
                <StackPanel x:Name="tlbr_Target_Block"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">

                    <!-- Four lines the user can raise and lower by hand. Round like
                         radio buttons because that is what a signal level looks
                         like, but each one is its own switch - they do not exclude
                         each other. -->
                    <ToggleButton x:Name="tlbr_Signal_1"
                                  Style="{StaticResource Style_Toolbar_Signal_Toggle}"
                                  Foreground="{StaticResource Brush_Signal_1}"
                                  ToolTip="User signal 1"
                                  Click="tlbr_Signal_1_Click"/>

                    <ToggleButton x:Name="tlbr_Signal_2"
                                  Style="{StaticResource Style_Toolbar_Signal_Toggle}"
                                  Foreground="{StaticResource Brush_Signal_2}"
                                  ToolTip="User signal 2"
                                  Click="tlbr_Signal_2_Click"/>

                    <ToggleButton x:Name="tlbr_Signal_3"
                                  Style="{StaticResource Style_Toolbar_Signal_Toggle}"
                                  Foreground="{StaticResource Brush_Signal_3}"
                                  ToolTip="User signal 3"
                                  Click="tlbr_Signal_3_Click"/>

                    <ToggleButton x:Name="tlbr_Signal_4"
                                  Style="{StaticResource Style_Toolbar_Signal_Toggle}"
                                  Foreground="{StaticResource Brush_Signal_4}"
                                  ToolTip="User signal 4"
                                  Click="tlbr_Signal_4_Click"/>

                    <Separator x:Name="tlbr_Target_Divider_Left"
                               Style="{StaticResource Style_Toolbar_Separator}"/>

                    <TextBlock x:Name="tlbr_Target_Label"
                               Style="{StaticResource Style_Toolbar_Label}"
                               Margin="4,0,2,0"
                               Text="Target"/>

                    <!-- Holds the target's reset line. Checked is held - red, "in
                         RESET" - and released is blue and running, which is where
                         it starts: nothing is asserted until it is asked for. -->
                    <ToggleButton x:Name="tlbr_Target_Reset"
                                  Style="{StaticResource Style_Toolbar_Target_Toggle}"
                                  Checked="tlbr_Target_Reset_Checked"
                                  Unchecked="tlbr_Target_Reset_Unchecked"/>

                    <Separator x:Name="tlbr_Target_Divider_Right"
                               Style="{StaticResource Style_Toolbar_Separator}"/>

                    <!-- A momentary reset, as against holding the line: pressed and
                         released in one go. Green until the moment it is pressed. -->
                    <Button x:Name="tlbr_Target_Pulse"
                            Style="{StaticResource Style_Toolbar_Pulse_Button}"
                            Content="&#xE896;"
                            ToolTip="Pulse the target's reset line"
                            Click="tlbr_Target_Pulse_Click"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ==================================================================
             Tool bar, second row - the project and workspace controls.

             The bar was full at the window's 1000px default, so it is two rows
             now. The probe and target controls are the hardware row above; every
             control that acts on the project or the workspace is down here.
             ================================================================== -->
        <Border x:Name="tlbr_Main"
                DockPanel.Dock="Top"
                Background="{StaticResource Brush_Chrome_Background}"
                BorderBrush="{StaticResource Brush_Chrome_Border}"
                BorderThickness="0,0,0,1"
                Padding="4,3">
            <DockPanel LastChildFill="False">

                <Button x:Name="tlbr_Open"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Content="&#xED25;"
                        ToolTip="Open Project (Ctrl+O)"
                        Click="tlbr_Open_Click"/>

                <Button x:Name="tlbr_Save"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Content="&#xE74E;"
                        ToolTip="Save Project (Ctrl+S)"
                        Click="tlbr_Save_Click"/>

                <Button x:Name="tlbr_ShowLog"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Foreground="{StaticResource Brush_Workspace_Action}"
                        Content="&#xE7C3;"
                        ToolTip="Show the event log"
                        Click="tlbr_ShowLog_Click"/>

                <!-- Arms the log. Unchecked - two bars - is paused, and is where it
                     starts, so nothing is recorded until it is asked for. -->
                <ToggleButton x:Name="tlbr_Record"
                              DockPanel.Dock="Left"
                              Style="{StaticResource Style_Toolbar_Record_Toggle}"
                              Checked="tlbr_Record_Checked"
                              Unchecked="tlbr_Record_Unchecked"/>

                <Separator x:Name="tlbr_Separator_Left"
                           DockPanel.Dock="Left"
                           Style="{StaticResource Style_Toolbar_Separator}"/>

                <Button x:Name="tlbr_ValueType"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Text_Button}"
                        Content="DEC"
                        ToolTip="Show every register value in decimal or hexadecimal"
                        Click="tlbr_ValueType_Click"/>


                <!-- Right-docked children fill from the right edge inwards, so the
                     first one declared ends up outermost. Reading the block below
                     bottom-up gives the order on screen. -->
                <ToggleButton x:Name="tlbr_CollapseAll"
                              DockPanel.Dock="Right"
                              Margin="2,0,2,0"
                              IsChecked="True"
                              Style="{StaticResource Style_Disclosure_Toggle}"
                              ToolTip="Open or close every device"
                              Checked="tlbr_CollapseAll_Checked"
                              Unchecked="tlbr_CollapseAll_Unchecked"/>

                <Separator x:Name="tlbr_Workspace_Divider_Right"
                           DockPanel.Dock="Right"
                           Style="{StaticResource Style_Toolbar_Separator}"/>

                <Button x:Name="tlbr_Workspace_Delete"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Foreground="{StaticResource Brush_Toolbar_Delete}"
                        Content="&#xE74D;"
                        ToolTip="Delete the view showing in the list"
                        Click="tlbr_Workspace_Delete_Click"/>

                <Button x:Name="tlbr_Workspace_Save"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Foreground="{StaticResource Brush_Workspace_Action}"
                        Content="&#xE74E;"
                        ToolTip="Left click : Save New Workspace.&#x0a;Right Click : Overwrite Selected Workspace"
                        Click="tlbr_Workspace_Save_Click"
                        MouseRightButtonUp="tlbr_Workspace_Save_MouseRightButtonUp"/>

                <ComboBox x:Name="tlbr_Workspace_List"
                          DockPanel.Dock="Right"
                          Width="118"
                          Margin="4,0"
                          VerticalAlignment="Center"
                          ToolTip="Saved views - which registers each device keeps on show"
                          SelectionChanged="tlbr_Workspace_List_SelectionChanged"/>

                <TextBlock x:Name="tlbr_Workspace_Label"
                           DockPanel.Dock="Right"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush_Workspace_Action}"
                           Text="Workspace"/>

                <Separator x:Name="tlbr_Workspace_Divider_Left"
                           DockPanel.Dock="Right"
                           Style="{StaticResource Style_Toolbar_Separator}"/>

                <Button x:Name="tlbr_Help"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Content="&#xE897;"
                        ToolTip="Help (F1)"
                        Click="tlbr_Help_Click"/>

                <!-- Declared last of the right-docked children, so it lands furthest
                     left - ahead of everything else on that side. -->
                <Separator x:Name="tlbr_Operation_Divider_Right"
                           DockPanel.Dock="Right"
                           Style="{StaticResource Style_Toolbar_Separator}"/>

                <!-- Declared before Write All, so it lands to the right of it -
                     between Write All and the help button. -->
                <Button x:Name="tlbr_Read_All"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Foreground="{StaticResource Brush_Toolbar_Read}"
                        Content="&#xE895;"
                        ToolTip="Read every register from every device"
                        Click="tlbr_Read_All_Click"/>

                <Button x:Name="tlbr_Write_All"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Content="&#xE8AB;"
                        ToolTip="Write every register to every device"
                        Click="tlbr_Write_All_Click"/>

                <!-- These widths were what the bar had room for when everything
                     shared one row at the window's 1000px default. There is slack
                     now that the probe block has a row of its own, but they are
                     left as they are: they fit their contents, and both combo
                     boxes being the same width they were is one less thing that
                     moved. -->
                <ComboBox x:Name="tlbr_Operation_List"
                          DockPanel.Dock="Right"
                          Width="132"
                          Margin="4,0"
                          VerticalAlignment="Center"
                          SelectedIndex="0"
                          ToolTip="When a change is written to the bus"
                          SelectionChanged="tlbr_Operation_List_SelectionChanged">
                    <ComboBoxItem Content="Register On Change"/>
                    <ComboBoxItem Content="Device On Change"/>
                    <ComboBoxItem Content="Visible On Change"/>
                </ComboBox>

                <TextBlock x:Name="tlbr_Operation_Label"
                           DockPanel.Dock="Right"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush_Text_Primary}"
                           Text="Operation"/>

                <Separator x:Name="tlbr_Operation_Divider_Left"
                           DockPanel.Dock="Right"
                           Style="{StaticResource Style_Toolbar_Separator}"/>

            </DockPanel>
        </Border>

        <!-- ==================================================================
             Status bar
             ================================================================== -->
        <StatusBar x:Name="sbar_Main" DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem x:Name="sbar_ActiveProject"
                           Grid.Column="0"
                           Content="No project"/>

            <Separator x:Name="sbar_Separator_1" Grid.Column="1"/>

            <StatusBarItem x:Name="sbar_status"
                           Grid.Column="2"
                           MinWidth="260"
                           HorizontalContentAlignment="Left"
                           Content="Ready"/>
        </StatusBar>

        <!-- ==================================================================
             Workspace - the application's real content goes here
             ================================================================== -->
        <!-- The devices on the bus, stacked. Both handlers are attached here rather
             than on each panel: the events bubble, so one of each covers every
             device added later as well. -->
        <!-- The checkerboard is built in code from the constants in AppSettings. -->
        <ScrollViewer x:Name="scr_Workspace"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">

            <!-- The decorator is inside the ScrollViewer on purpose. The window has
                 an adorner layer of its own, but one up there is not clipped by the
                 scroll region, so the drop line would draw over the toolbar. -->
            <AdornerDecorator>
                <StackPanel x:Name="stk_Devices"
                            Orientation="Vertical"
                            Background="Transparent"
                            local:BitFieldEditor.IllegalEntry="stk_Devices_IllegalEntry"
                            local:DevicePanel.LoadFailed="stk_Devices_LoadFailed"
                            local:DevicePanel.CloneRequested="stk_Devices_CloneRequested"
                            local:DevicePanel.DeleteRequested="stk_Devices_DeleteRequested"
                            local:DevicePanel.ReorderStarted="stk_Devices_ReorderStarted">

                    <local:DevicePanel x:Name="dvp_Device"
                                       Margin="0,0,0,6"
                                       HorizontalAlignment="Stretch"
                                       FunctionName="Front panel I/O"/>

                </StackPanel>
            </AdornerDecorator>
        </ScrollViewer>

    </DockPanel>
</Window>
