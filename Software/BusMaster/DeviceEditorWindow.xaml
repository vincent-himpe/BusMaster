<Window x:Class="DeviceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BusMaster"
        mc:Ignorable="d"
        Title="Device Editor"
        Height="560" Width="940" MinHeight="380" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush_Window_Background}"
        Foreground="{StaticResource Brush_Text_Primary}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <DockPanel LastChildFill="True">

        <!-- ==================================================================
             Fixed header region. Labels above their boxes; the description
             takes whatever width the three sized fields leave.
             ================================================================== -->
        <Grid x:Name="grd_Header" DockPanel.Dock="Top" Margin="10,10,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label x:Name="lbl_DeviceName" Grid.Row="0" Grid.Column="0"
                   Style="{StaticResource Style_Editor_Label}" Margin="0,0,8,0" Content="Device Name"/>
            <TextBox x:Name="txt_DeviceName" Grid.Row="1" Grid.Column="0"
                     Style="{StaticResource Style_Editor_Field}"
                     Width="92" Margin="0,0,8,0"
                     TextChanged="txt_DeviceName_TextChanged"/>

            <Label x:Name="lbl_DeviceDescription" Grid.Row="0" Grid.Column="1"
                   Style="{StaticResource Style_Editor_Label}" Margin="0,0,8,0" Content="Device Description"/>
            <TextBox x:Name="txt_DeviceDescription" Grid.Row="1" Grid.Column="1"
                     Style="{StaticResource Style_Editor_Field}"
                     MinWidth="120" Margin="0,0,8,0"
                     TextChanged="txt_DeviceDescription_TextChanged"/>

            <Label x:Name="lbl_BaseAddress" Grid.Row="0" Grid.Column="2"
                   Style="{StaticResource Style_Editor_Label}" Margin="0,0,8,0" Content="Base Address"/>
            <TextBox x:Name="txt_BaseAddress" Grid.Row="1" Grid.Column="2"
                     Style="{StaticResource Style_Editor_Field}"
                     Width="42" MaxLength="3" Margin="0,0,8,0"
                     TextAlignment="Center"
                     TextChanged="txt_BaseAddress_TextChanged"/>

            <!-- Live readout of the 7 bit address the part will really answer to.
                 In line with the boxes, not with the labels. -->
            <TextBlock x:Name="lbl_AddressReadout" Grid.Row="1" Grid.Column="3"
                       Style="{StaticResource Style_Editor_Address_Readout}"
                       Width="118" Margin="0,0,8,0"/>

            <Label x:Name="lbl_AddressBits" Grid.Row="0" Grid.Column="4"
                   Style="{StaticResource Style_Editor_Label}" Content="Address bits"/>
            <!-- 0 to 7, so a single digit is all it can ever hold. -->
            <TextBox x:Name="txt_AddressBits" Grid.Row="1" Grid.Column="4"
                     Style="{StaticResource Style_Editor_Field}"
                     Width="34" MaxLength="1"
                     TextAlignment="Center"
                     TextChanged="txt_AddressBits_TextChanged"/>
        </Grid>

        <!-- ==================================================================
             Register table tool bar. Rows are only ever added from here, so the
             width of the register is decided at the moment it is created: green
             8 for one address, blue 16 for a pair.

             Refresh sits on its own at the left, away from the two buttons that
             change the table, and Delete is pushed out to the right so it cannot
             be hit by mistake on the way to them.
             ================================================================== -->
        <Border x:Name="tlbr_Registers"
                DockPanel.Dock="Top"
                Margin="10,0,10,6"
                Background="{StaticResource Brush_Chrome_Background}"
                BorderBrush="{StaticResource Brush_Chrome_Border}"
                BorderThickness="1"
                Padding="4,3">
            <DockPanel LastChildFill="False">

                <Button x:Name="tlbr_SortRows"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Content="&#xE72C;"
                        ToolTip="Sort the rows by register address, and repaint the group blocks"
                        Click="tlbr_SortRows_Click"/>

                <Separator x:Name="tlbr_Registers_Divider"
                           DockPanel.Dock="Left"
                           Style="{StaticResource Style_Toolbar_Separator}"/>

                <Button x:Name="tlbr_Add8"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Register_Button}"
                        Foreground="{StaticResource Brush_Register_Byte}"
                        ToolTip="Add an 8 bit register - one address, no group"
                        Click="tlbr_Add8_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Style_Toolbar_Register_Width}" Text="8"/>
                        <TextBlock Style="{StaticResource Style_Toolbar_Register_Chip}" Text="&#xE950;"/>
                    </StackPanel>
                </Button>

                <Button x:Name="tlbr_Add16"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Register_Button}"
                        Foreground="{StaticResource Brush_Register_Word}"
                        ToolTip="Add a 16 bit register - two consecutive addresses sharing a group"
                        Click="tlbr_Add16_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Style_Toolbar_Register_Width}" Text="16"/>
                        <TextBlock Style="{StaticResource Style_Toolbar_Register_Chip}" Text="&#xE950;"/>
                    </StackPanel>
                </Button>

                <!-- Register Address only. The bit names are words and the group tag
                     is a label, so neither has a radix to switch; this is the one
                     column in the table that holds a number. -->
                <Separator x:Name="tlbr_Registers_Divider_Radix"
                           DockPanel.Dock="Left"
                           Style="{StaticResource Style_Toolbar_Separator}"/>

                <Button x:Name="tlbr_AddressRadix"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style_Toolbar_Text_Button}"
                        Content="DEC"
                        ToolTip="Show Register Address in decimal or hexadecimal.&#x0a;The device file itself is always written in decimal."
                        Click="tlbr_AddressRadix_Click"/>

                <Button x:Name="tlbr_DeleteRow"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Style_Toolbar_Button}"
                        Foreground="{StaticResource Brush_Toolbar_Delete}"
                        Content="&#xE74D;"
                        ToolTip="Delete the row the cursor is on (Ctrl+Delete).&#x0a;Only that row - the rest of its group stays."
                        Click="tlbr_DeleteRow_Click"/>

            </DockPanel>
        </Border>

        <!-- ==================================================================
             Save / Cancel
             ================================================================== -->
        <Grid x:Name="grd_Buttons" DockPanel.Dock="Bottom" Margin="10,8,10,10">
            <!-- Not IsCancel - see DeviceEditorCore.CancelEditor. Escape is taken
                 from the window's KeyDown instead. -->
            <Button x:Name="btn_Cancel" HorizontalAlignment="Left"
                    Content="_Cancel" Click="btn_Cancel_Click"/>
            <Button x:Name="btn_Save" HorizontalAlignment="Right"
                    Content="_Save" IsDefault="True" Click="btn_Save_Click"/>
        </Grid>

        <!-- ==================================================================
             Register table. Register Address is 75% black on white; the eight
             data columns are black on light blue.
             ================================================================== -->
        <DataGrid x:Name="grd_Registers"
                  Margin="10,0,10,0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  SelectionUnit="Cell"
                  SelectionMode="Extended">
            <DataGrid.Columns>

                <!-- Type the address in. Nothing sorts by clicking a header any more -
                     the toolbar's sort button is the only way, so a stray click on the
                     header cannot rearrange the table. -->
                <DataGridTextColumn Header="Register Address" Width="100"
                                    Binding="{Binding RegisterAddressText, UpdateSourceTrigger=PropertyChanged}"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource Style_Grid_Cell_Address}"
                                    ElementStyle="{StaticResource Style_Grid_Display}"
                                    EditingElementStyle="{StaticResource Style_Grid_Edit_Address}"/>

                <!-- Blank is an ordinary 8 bit register. A tag shared with the row at
                     the next address makes the two one wider register, and the shared
                     row colour is what shows it. -->
                <DataGridTextColumn Header="Group" Width="58"
                                    Binding="{Binding RegisterGroup, UpdateSourceTrigger=PropertyChanged}"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource Style_Grid_Cell_Group}"
                                    ElementStyle="{StaticResource Style_Grid_Display}"
                                    EditingElementStyle="{StaticResource Style_Grid_Edit_Group}"/>

                <!-- QuickViz. The header is a glyph so the column can be as narrow
                     as the tick it holds. A template column rather than a check box
                     one: the tick answers to a single click that way, and the cell
                     never goes into edit mode at all. -->
                <DataGridTemplateColumn Width="30" CanUserSort="False"
                                        CellStyle="{StaticResource Style_Grid_Cell_Data}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="&#xE8A3;"
                                   FontFamily="{StaticResource Font_Glyph}"
                                   FontWeight="{StaticResource Weight_Glyph}"
                                   FontSize="14"
                                   ToolTip="QuickViz"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource Style_Grid_QuickViz_Toggle}"
                                          IsChecked="{Binding QuickViz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Register Name" Width="150"
                                    Binding="{Binding RegisterName, UpdateSourceTrigger=PropertyChanged}"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource Style_Grid_Cell_Data}"
                                    ElementStyle="{StaticResource Style_Grid_Display}"
                                    EditingElementStyle="{StaticResource Style_Grid_Edit_Data}"/>

                <DataGridTextColumn Header="D7" Width="*"
                                    Binding="{Binding D7, UpdateSourceTrigger=PropertyChanged}"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource Style_Grid_Cell_Data}"
                                    ElementStyle="{StaticResource Style_Grid_Display}"
                                    EditingElementStyle="{StaticResource Style_Grid_Edit_Data}"/>

                <DataGridTextColumn Header="D6" Width="*"
                                    Binding="{Binding D6, UpdateSourceTrigger=PropertyChanged}"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource Style_Grid_Cell_Data}"
                                    ElementStyle="{StaticResource Style_Grid_Display}"
                                    EditingElementStyle="{StaticResource Style_Grid_Edit_Data}"/>

                <DataGridTextColumn Header="D5" Width="*"
                                    Binding="{Binding D5, UpdateSourceTrigger=PropertyChanged}"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource Style_Grid_Cell_Data}"
                                    ElementStyle="{StaticResource Style_Grid_Display}"
                                    EditingElementStyle="{StaticResource Style_Grid_Edit_Data}"/>

                <DataGridTextColumn Header="D4" Width="*"
                                    Binding="{Binding D4, UpdateSourceTrigger=PropertyChanged}"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource Style_Grid_Cell_Data}"
                                    ElementStyle="{StaticResource Style_Grid_Display}"
                                    EditingElementStyle="{StaticResource Style_Grid_Edit_Data}"/>

                <DataGridTextColumn Header="D3" Width="*"
                                    Binding="{Binding D3, UpdateSourceTrigger=PropertyChanged}"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource Style_Grid_Cell_Data}"
                                    ElementStyle="{StaticResource Style_Grid_Display}"
                                    EditingElementStyle="{StaticResource Style_Grid_Edit_Data}"/>

                <DataGridTextColumn Header="D2" Width="*"
                                    Binding="{Binding D2, UpdateSourceTrigger=PropertyChanged}"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource Style_Grid_Cell_Data}"
                                    ElementStyle="{StaticResource Style_Grid_Display}"
                                    EditingElementStyle="{StaticResource Style_Grid_Edit_Data}"/>

                <DataGridTextColumn Header="D1" Width="*"
                                    Binding="{Binding D1, UpdateSourceTrigger=PropertyChanged}"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource Style_Grid_Cell_Data}"
                                    ElementStyle="{StaticResource Style_Grid_Display}"
                                    EditingElementStyle="{StaticResource Style_Grid_Edit_Data}"/>

                <DataGridTextColumn Header="D0" Width="*"
                                    Binding="{Binding D0, UpdateSourceTrigger=PropertyChanged}"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource Style_Grid_Cell_Data}"
                                    ElementStyle="{StaticResource Style_Grid_Display}"
                                    EditingElementStyle="{StaticResource Style_Grid_Edit_Data}"/>

            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
