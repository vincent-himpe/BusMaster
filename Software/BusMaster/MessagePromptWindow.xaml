<Window x:Class="MessagePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BusMaster"
        mc:Ignorable="d"
        Title="BusMaster"
        SizeToContent="WidthAndHeight"
        MinWidth="470"
        MaxWidth="760"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush_Window_Background}"
        Foreground="{StaticResource Brush_Text_Primary}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- The box is as wide as it has to be, between those two limits. Most messages
         are a sentence or two and come out at the minimum, which is what keeps them
         all looking alike; the F1 help is thirty lines laid out in sections and
         would be shredded by wrapping, so it takes the room it needs instead. The
         maximum is there because a line of text much wider than this stops being
         readable - past it, a long message wraps after all. -->

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>

            <!-- Star, not Auto, and that is what makes the scroller work. An Auto
                 row is given its full desired height first, so on a message taller
                 than the box the text would take the lot, the ScrollViewer would
                 never be squeezed - and so would never scroll - and the button row
                 below would be pushed off the bottom of the window. Star takes
                 what is left after the buttons have had theirs. While the window
                 is free to grow, star measures the same as Auto, so a message that
                 fits is laid out exactly as before. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- Which of the four faces this is: something worth knowing, something
             worth thinking twice about, something that did not happen, or a
             question. Four times the height of the text beside it, and the only
             thing on the form that carries a colour - the message itself is always
             read in the ordinary text colour. MessagePrompt sets the glyph and the
             brush together. -->
        <TextBlock x:Name="lbl_Icon"
                   Grid.Row="0" Grid.Column="0"
                   Margin="0,0,16,0"
                   VerticalAlignment="Top"
                   FontFamily="{StaticResource Font_Glyph}"
                   FontWeight="{StaticResource Weight_Glyph}"
                   FontSize="48"
                   Foreground="{StaticResource Brush_Message_Info}"
                   Text="&#xE946;"/>

        <!-- The scroller earns its keep once, on the F1 help: the box cannot be
             resized, so a message taller than the screen would have a bottom the
             user could never reach. It adds nothing to the look of a message that
             fits - no bar is drawn unless there is something to scroll - and
             MessagePrompt is what stops the window growing past the work area. -->
        <ScrollViewer Grid.Row="0" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Center"
                      Padding="0,0,4,0">

            <!-- A TextBlock, not a Label: a Label runs the string through
                 AccessText, which would swallow any underscore in the message. -->
            <TextBlock x:Name="lbl_Message"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Brush_Text_Primary}"
                       Text="Message"/>

        </ScrollViewer>

        <!-- Every button the box can offer, in the order they are read. Which of
             them are on show is what the mode decides; MessagePrompt.Arrange hides
             the rest.

             None of them is marked IsCancel. That property carries a side effect -
             WPF sets DialogResult itself when Escape is pressed - and with three
             buttons the answer has to say which one, so Escape is handled in
             Window_PreviewKeyDown instead and every way out goes through one
             routine. -->
        <StackPanel Grid.Row="1" Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">

            <Button x:Name="btn_Ok"
                    Content="_OK"
                    MinWidth="76"
                    Margin="8,0,0,0"
                    Click="btn_Ok_Click"/>

            <Button x:Name="btn_Yes"
                    Content="_Yes"
                    MinWidth="76"
                    Margin="8,0,0,0"
                    Click="btn_Yes_Click"/>

            <Button x:Name="btn_No"
                    Content="_No"
                    MinWidth="76"
                    Margin="8,0,0,0"
                    Click="btn_No_Click"/>

            <Button x:Name="btn_Cancel"
                    Content="_Cancel"
                    MinWidth="76"
                    Margin="8,0,0,0"
                    Click="btn_Cancel_Click"/>

        </StackPanel>
    </Grid>
</Window>
