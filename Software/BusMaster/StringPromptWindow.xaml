<Window x:Class="StringPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BusMaster"
        mc:Ignorable="d"
        Title="BusMaster"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush_Window_Background}"
        Foreground="{StaticResource Brush_Text_Primary}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- A TextBlock, not a Label: a Label runs the string through AccessText,
             which would swallow any underscore in the prompt. -->
        <TextBlock x:Name="lbl_Prompt"
                   Grid.Row="0"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Brush_Text_Primary}"
                   Text="Name:"/>

        <TextBox x:Name="txt_Value"
                 Grid.Row="1"
                 Padding="4,4"
                 FontFamily="Consolas"
                 FontSize="13"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">

            <Button x:Name="btn_Ok"
                    Content="_OK"
                    IsDefault="True"
                    Margin="0,0,8,0"
                    Click="btn_Ok_Click"/>

            <Button x:Name="btn_Cancel"
                    Content="_Cancel"
                    IsCancel="True"
                    Click="btn_Cancel_Click"/>

        </StackPanel>
    </Grid>
</Window>
