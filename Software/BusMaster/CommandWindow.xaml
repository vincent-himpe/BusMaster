<Window x:Class="CommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BusMaster"
        mc:Ignorable="d"
        Title="Command"
        Height="520" Width="760" MinHeight="260" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Brush_Window_Background}"
        Foreground="{StaticResource Brush_Text_Primary}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <DockPanel LastChildFill="True">

        <!-- ==================================================================
             The line being typed. Docked first so it keeps its height when the
             window is resized and the history takes the rest.
             ================================================================== -->
        <Grid DockPanel.Dock="Bottom" Margin="6,0,6,6">

            <TextBox x:Name="txt_ActiveCommand"
                     FontFamily="Consolas"
                     FontSize="13"
                     Padding="4,4"
                     AcceptsReturn="False"
                     AcceptsTab="False"
                     PreviewKeyDown="txt_ActiveCommand_PreviewKeyDown"
                     TextChanged="txt_ActiveCommand_TextChanged"
                     LostKeyboardFocus="txt_ActiveCommand_LostKeyboardFocus"/>

            <!-- The completion list. StaysOpen keeps the caret in the box while
                 it is up: the list is steered from the keyboard, never clicked
                 into. -->
            <Popup x:Name="pop_Completions"
                   PlacementTarget="{Binding ElementName=txt_ActiveCommand}"
                   Placement="Top"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="None">
                <Border Background="{StaticResource Brush_Popup_Background}"
                        BorderBrush="{StaticResource Brush_Chrome_Border}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <ListBox x:Name="lst_Completions"
                             Style="{StaticResource Style_Completion_List}"
                             MaxHeight="180"
                             MinWidth="180"/>
                </Border>
            </Popup>

        </Grid>

        <!-- ==================================================================
             What has been run, and what came back.

             Editable on purpose: it doubles as a scratch pad of commands the user
             keeps, rearranges and runs again. Enter runs the line the caret is
             on, Ctrl+Enter makes a new one.
             ================================================================== -->
        <RichTextBox x:Name="rtb_CommandHistory"
                     Margin="6,6,6,4"
                     Style="{StaticResource Style_Command_History}"
                     PreviewKeyDown="rtb_CommandHistory_PreviewKeyDown"
                     SelectionChanged="rtb_CommandHistory_SelectionChanged">
            <RichTextBox.Resources>
                <!-- A paragraph is a line here, not a block of prose, so the
                     default spacing around it has to go. -->
                <Style TargetType="{x:Type Paragraph}">
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>

    </DockPanel>
</Window>
